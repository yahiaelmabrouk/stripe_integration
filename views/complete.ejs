<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Complete</title>
    <style>
      body {
        font-family: "Segoe UI", Arial, sans-serif;
        background: #f7f7f9;
        margin: 0;
        padding: 0;
      }
      .container {
        max-width: 420px;
        margin: 60px auto;
        background: #fff;
        border-radius: 12px;
        box-shadow: 0 2px 16px rgba(0, 0, 0, 0.08);
        padding: 36px 28px;
        text-align: center;
      }
      .icon {
        font-size: 60px;
        color: #4caf50;
        margin-bottom: 18px;
      }
      h1 {
        color: #222;
        margin-bottom: 12px;
      }
      p {
        color: #555;
        font-size: 1.1em;
        margin-bottom: 28px;
      }
      a {
        display: inline-block;
        background: #635bff;
        color: #fff;
        text-decoration: none;
        padding: 10px 28px;
        border-radius: 6px;
        font-size: 1em;
        transition: background 0.2s;
      }
      a:hover {
        background: #4b44c7;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="icon">✔️</div>
      <h1>Payment Successful!</h1>
      <p>Thank you for your purchase.<br />Your payment has been processed.</p>
      <a href="/">Back to Home</a>
    </div>
  </body>
</html>
